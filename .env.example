# ─────────────────────────────────────────────────────────────
# ABNSoft Pilotage — modèle de configuration
# Copiez vers .env puis renseignez les valeurs. Ne commitez jamais .env.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
# URL publique (HTTPS en production) : liens d'invitation, callbacks OAuth et GitHub
APP_URL="http://localhost:3000"
ORGANIZATION_SLUG="abnsoft"
ORGANIZATION_NAME="ABN Software Synergie"
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"

# ── Base de données ──────────────────────────────────────────
# Développement local. Avec docker compose, DATABASE_URL est construite à partir de POSTGRES_PASSWORD.
# Neon : `neon env pull` écrit DATABASE_URL (poolée, hôte « -pooler ») et DATABASE_URL_UNPOOLED
# dans .env.local, lu en priorité sur .env. L'application utilise l'URL poolée ; migrations et
# réinitialisation dérivent automatiquement l'URL directe (hôte sans « -pooler »).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pilotage?schema=public"
DATABASE_POOL_SIZE="10"
# Utilisé par docker-compose.yml (générez une valeur forte : openssl rand -base64 24)
POSTGRES_PASSWORD=""
# Port exposé sur 127.0.0.1 par docker compose (le reverse proxy s'y connecte)
WEB_PORT="3000"

# ── Authentification (Auth.js + Google OIDC) ─────────────────
# Secret de chiffrement des jetons et de signature d'état GitHub — openssl rand -base64 32
AUTH_SECRET=""
# Identifiants OAuth du projet Google Cloud (docs/GOOGLE_OAUTH.md)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Domaines Google Workspace autorisés, séparés par des virgules. Le claim « hd » du jeton
# d'identité est vérifié (un compte Gmail personnel ne passe jamais). Obligatoire en production.
ALLOWED_GOOGLE_DOMAINS="abnsoft.ma"
# Super-administrateurs (virgules) : ADMIN actifs dès leur connexion Google, non rétrogradables depuis l'application.
SUPER_ADMIN_EMAILS="m.abdelbasset@abnsoft.ma"
# Durée de vie maximale d'une session (heures). Les sessions sont révocables en base.
SESSION_MAX_AGE_HOURS="168"
# Connexion de démonstration sans Google — ignorée quand NODE_ENV=production.
AUTH_DEV_LOGIN="false"

# ── GitHub App (docs/GITHUB_APP.md) ──────────────────────────
GITHUB_APP_ID=""
# Nom court de l'application (URL github.com/apps/<slug>)
GITHUB_APP_SLUG=""
# Clé privée PEM. Sur une ligne, remplacez les retours à la ligne par \n.
GITHUB_APP_PRIVATE_KEY=""
# Secret du webhook (openssl rand -hex 32), identique à celui saisi dans GitHub
GITHUB_WEBHOOK_SECRET=""
# Propriétaires GitHub (organisations ou comptes) autorisés à installer l'application,
# séparés par des virgules. Vide = tout propriétaire accepté.
GITHUB_ALLOWED_OWNERS=""

# ── Pièces jointes ───────────────────────────────────────────
# Stockées hors du dossier public ; servies via /api/attachments/<id> après contrôle d'accès.
UPLOAD_DIR="./storage/uploads"
UPLOAD_MAX_BYTES="10485760"
