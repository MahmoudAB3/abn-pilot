// ABNSoft Pilotage — schéma PostgreSQL
// Conventions : identifiants cuid, horodatages UTC, suppression logique (archivedAt) pour les tickets.
// Contraintes non exprimables en Prisma (index partiels, CHECK, tsvector) : voir prisma/migrations/*_constraints.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "queryCompiler"]
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Énumérations ───────────────────────────────

enum OrgRole {
  ADMIN
  PRODUCT_OWNER
  DEVELOPER
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  ARCHIVED
}

/// Rôle dans un projet : VIEWER restreint un membre à la lecture, quel que soit son rôle d'organisation.
enum ProjectRole {
  LEAD
  MEMBER
  VIEWER
}

enum IssueType {
  EPIC
  STORY
  TASK
  BUG
  SUBTASK
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  LOWEST
}

/// Catégorie stable d'un statut de workflow : les automatisations et rapports s'y réfèrent,
/// ce qui permet de renommer librement les statuts.
enum StatusCategory {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  IN_TEST
  DONE
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum IssueLinkType {
  BLOCKS
  RELATES_TO
  DUPLICATES
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

enum ReleaseStatus {
  PLANNED
  IN_PROGRESS
  RELEASED
  CANCELLED
}

enum ActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  ASSIGNED
  COMMENTED
  ATTACHMENT_ADDED
  LINKED
  ARCHIVED
  RESTORED
  SPRINT_CHANGED
  WORK_LOGGED
  COMMIT_LINKED
  PR_LINKED
  PR_UPDATED
  AUTOMATION
}

enum NotificationType {
  ASSIGNED
  MENTIONED
  STATUS_CHANGED
  COMMENTED
  PR_ACTIVITY
}

enum StatusChangeSource {
  USER
  AUTOMATION
  SPRINT
}

enum PrState {
  OPEN
  CLOSED
  MERGED
}

enum ReviewState {
  NONE
  REVIEW_REQUESTED
  APPROVED
  CHANGES_REQUESTED
  COMMENTED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  IGNORED
}

// ─────────────────────────── Organisation et accès ──────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  memberships OrganizationMembership[]
  projects    Project[]
  github      GitHubInstallation[]
  auditLogs   AuditLog[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  locale        String    @default("fr")
  /// Préférences de notification : { assigned, mentioned, statusChanged, commented, prActivity } (booléens)
  notificationPrefs Json  @default("{}")
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  memberships       OrganizationMembership[]
  projectMembers    ProjectMembership[]
  ledProjects       Project[]            @relation("ProjectLead")
  assignedIssues    Issue[]              @relation("Assignee")
  reportedIssues    Issue[]              @relation("Reporter")
  comments          Comment[]
  attachments       Attachment[]
  activities        IssueActivity[]
  notifications     Notification[]       @relation("NotificationRecipient")
  notificationsSent Notification[]       @relation("NotificationActor")
  watching          IssueWatcher[]
  savedFilters      SavedFilter[]
  recentViews       RecentView[]
  workLogs          WorkLog[]
  statusChanges     IssueStatusHistory[]
}

// Modèles standard Auth.js (adaptateur Prisma). Sessions en base : révocables côté serveur.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model OrganizationMembership {
  id            String           @id @default(cuid())
  orgId         String
  userId        String
  role          OrgRole          @default(DEVELOPER)
  status        MembershipStatus @default(INVITED)
  invitedById   String?
  invitedAt     DateTime         @default(now())
  activatedAt   DateTime?
  deactivatedAt DateTime?

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([orgId, status])
}

/// Personne du domaine autorisé qui s'est authentifiée sans invitation : en attente d'approbation.
model AccessRequest {
  id           String              @id @default(cuid())
  email        String              @unique
  name         String?
  image        String?
  hostedDomain String
  status       AccessRequestStatus @default(PENDING)
  requestedAt  DateTime            @default(now())
  reviewedById String?
  reviewedAt   DateTime?
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  actorId    String?
  action     String
  targetType String
  targetId   String?
  data       Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

// ───────────────────────────────── Projets ──────────────────────────────────

model Project {
  id           String        @id @default(cuid())
  orgId        String
  /// Clé immuable (ex. ERP) : garantit la stabilité des clés de tickets après renommage.
  key          String
  name         String
  description  String        @default("")
  leadId       String?
  status       ProjectStatus @default(ACTIVE)
  targetDate   DateTime?     @db.Date
  /// Compteur incrémenté atomiquement pour générer ERP-1, ERP-2…
  issueCounter Int           @default(0)

  // Automatisations GitHub — toutes désactivées par défaut.
  autoReviewOnPrOpen           Boolean         @default(false)
  autoInProgressOnChangesAsked Boolean         @default(false)
  autoOnMergeCategory          StatusCategory?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead         User?               @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  members      ProjectMembership[]
  statuses     WorkflowStatus[]
  issues       Issue[]
  labels       Label[]
  sprints      Sprint[]
  milestones   Milestone[]
  releases     Release[]
  repositories ProjectRepository[]
  savedFilters SavedFilter[]

  @@unique([orgId, key])
}

model ProjectMembership {
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  addedAt   DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

/// Statuts du workflow d'un projet (Backlog → À faire → En cours → En revue → En test → Terminé par défaut).
model WorkflowStatus {
  id        String         @id @default(cuid())
  projectId String
  name      String
  category  StatusCategory
  position  Int
  /// Limite WIP facultative affichée sur le tableau.
  wipLimit  Int?

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues      Issue[]
  historyFrom IssueStatusHistory[] @relation("FromStatus")
  historyTo   IssueStatusHistory[] @relation("ToStatus")

  @@unique([projectId, name])
  @@index([projectId, position])
}

model Label {
  id        String @id @default(cuid())
  projectId String
  name      String
  color     String @default("gris")

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  IssueLabel[]

  @@unique([projectId, name])
}

// ───────────────────────────────── Tickets ──────────────────────────────────

model Issue {
  id          String    @id @default(cuid())
  projectId   String
  number      Int
  key         String    @unique
  title       String
  /// Markdown, rendu côté serveur puis assaini (DOMPurify).
  description String    @default("")
  type        IssueType @default(TASK)
  statusId    String
  priority    Priority  @default(MEDIUM)
  assigneeId  String?
  reporterId  String
  /// Épopée parente (story/tâche/bug) ou ticket parent (sous-tâche).
  parentId    String?
  sprintId    String?
  milestoneId String?
  releaseId   String?
  storyPoints Int?
  dueDate     DateTime? @db.Date
  /// Ordre dans le backlog et les colonnes (insertion au milieu, rééquilibrage ponctuel).
  rank        Float     @default(0)
  blocked     Boolean   @default(false)
  blockedReason String?
  completedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Colonne générée (tsvector français) — créée par migration SQL, ignorée par le client.
  searchVector Unsupported("tsvector")?

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status    WorkflowStatus  @relation(fields: [statusId], references: [id], onDelete: Restrict)
  assignee  User?           @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter  User            @relation("Reporter", fields: [reporterId], references: [id], onDelete: Restrict)
  parent    Issue?          @relation("Hierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Issue[]         @relation("Hierarchy")
  sprint    Sprint?         @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  milestone Milestone?      @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  release   Release?        @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  labels        IssueLabel[]
  comments      Comment[]
  attachments   Attachment[]
  activities    IssueActivity[]
  statusHistory IssueStatusHistory[]
  watchers      IssueWatcher[]
  linksOut      IssueLink[]          @relation("LinkSource")
  linksIn       IssueLink[]          @relation("LinkTarget")
  githubLinks   GitHubIssueLink[]
  notifications Notification[]
  recentViews   RecentView[]
  workLogs      WorkLog[]

  @@unique([projectId, number])
  @@index([projectId, statusId, rank])
  @@index([projectId, sprintId, rank])
  @@index([assigneeId, archivedAt])
  @@index([parentId])
  @@index([projectId, updatedAt])
}

model IssueLabel {
  issueId String
  labelId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@index([labelId])
}

model IssueLink {
  id        String        @id @default(cuid())
  sourceId  String
  targetId  String
  type      IssueLinkType
  createdAt DateTime      @default(now())

  source Issue @relation("LinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target Issue @relation("LinkTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([targetId])
}

model Comment {
  id        String    @id @default(cuid())
  issueId   String
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  searchVector Unsupported("tsvector")?

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([issueId, createdAt])
}

model Attachment {
  id         String   @id @default(cuid())
  issueId    String
  uploaderId String
  filename   String
  mimeType   String
  size       Int
  /// Chemin relatif dans UPLOAD_DIR (nom aléatoire, jamais dérivé du nom fourni).
  storageKey String   @unique
  createdAt  DateTime @default(now())

  issue    Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploader User  @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([issueId])
}

model IssueActivity {
  id        String       @id @default(cuid())
  issueId   String
  /// Null pour les évènements système (GitHub, automatisations).
  actorId   String?
  type      ActivityType
  data      Json         @default("{}")
  createdAt DateTime     @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([issueId, createdAt])
  @@index([createdAt])
}

model IssueStatusHistory {
  id           String             @id @default(cuid())
  issueId      String
  fromStatusId String?
  toStatusId   String
  changedById  String?
  source       StatusChangeSource @default(USER)
  changedAt    DateTime           @default(now())

  issue      Issue           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  fromStatus WorkflowStatus? @relation("FromStatus", fields: [fromStatusId], references: [id], onDelete: SetNull)
  toStatus   WorkflowStatus  @relation("ToStatus", fields: [toStatusId], references: [id], onDelete: Cascade)
  changedBy  User?           @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([issueId, changedAt])
}

model IssueWatcher {
  issueId String
  userId  String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([issueId, userId])
  @@index([userId])
}

model WorkLog {
  id        String   @id @default(cuid())
  issueId   String
  userId    String
  minutes   Int
  date      DateTime @db.Date
  note      String   @default("")
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([issueId])
}

// ─────────────────────────── Sprints et livraison ───────────────────────────

model Sprint {
  id              String       @id @default(cuid())
  projectId       String
  name            String
  goal            String       @default("")
  startDate       DateTime     @db.Date
  endDate         DateTime     @db.Date
  status          SprintStatus @default(PLANNED)
  startedAt       DateTime?
  completedAt     DateTime?
  /// Points engagés figés au démarrage, points livrés figés à la clôture (source de la vélocité).
  committedPoints Int?
  completedPoints Int?
  completedIssues Int?
  createdAt       DateTime     @default(now())

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]
  snapshots SprintSnapshot[]

  @@index([projectId, status])
}

/// Relevé quotidien d'un sprint actif (burndown réel, jamais reconstruit a posteriori).
model SprintSnapshot {
  id              String   @id @default(cuid())
  sprintId        String
  date            DateTime @db.Date
  totalPoints     Int
  completedPoints Int
  totalIssues     Int
  completedIssues Int
  capturedAt      DateTime @default(now())

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@unique([sprintId, date])
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  name        String
  description String          @default("")
  targetDate  DateTime?       @db.Date
  status      MilestoneStatus @default(PLANNED)
  createdAt   DateTime        @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId])
}

model Release {
  id          String        @id @default(cuid())
  projectId   String
  name        String
  version     String
  status      ReleaseStatus @default(PLANNED)
  plannedDate DateTime?     @db.Date
  releasedAt  DateTime?
  notes       String        @default("")
  createdAt   DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@unique([projectId, version])
}

// ───────────────────────── Collaboration et productivité ────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  type      NotificationType
  issueId   String?
  title     String
  body      String           @default("")
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user  User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User?  @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  issue Issue? @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  name      String
  filters   Json
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecentView {
  userId   String
  issueId  String
  viewedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([userId, issueId])
  @@index([userId, viewedAt])
}

// ─────────────────────────────────── GitHub ─────────────────────────────────
// Aucun jeton n'est stocké : les jetons d'installation sont générés à la demande
// à partir de la clé privée de la GitHub App (variable d'environnement).

model GitHubInstallation {
  id                  String    @id @default(cuid())
  orgId               String
  installationId      BigInt    @unique
  accountLogin        String
  accountType         String
  repositorySelection String
  suspendedAt         DateTime?
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  org          Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  repositories GitHubRepository[]
}

model GitHubRepository {
  id             String    @id @default(cuid())
  installationId String
  githubId       BigInt    @unique
  owner          String
  name           String
  fullName       String
  private        Boolean
  defaultBranch  String    @default("main")
  htmlUrl        String
  /// Renseigné quand le dépôt est retiré de l'installation (les liens historiques sont conservés).
  removedAt      DateTime?
  createdAt      DateTime  @default(now())

  installation GitHubInstallation  @relation(fields: [installationId], references: [id], onDelete: Cascade)
  projects     ProjectRepository[]
  commits      GitHubCommit[]
  pullRequests GitHubPullRequest[]
  syncState    GitHubSyncState?

  @@index([installationId])
}

model ProjectRepository {
  projectId    String
  repositoryId String
  linkedById   String?
  createdAt    DateTime @default(now())

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repository GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@id([projectId, repositoryId])
  @@index([repositoryId])
}

model GitHubCommit {
  id           String   @id @default(cuid())
  repositoryId String
  sha          String
  message      String
  authorName   String
  authorLogin  String?
  url          String
  committedAt  DateTime
  createdAt    DateTime @default(now())

  repository GitHubRepository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  issueLinks GitHubIssueLink[]

  @@unique([repositoryId, sha])
  @@index([committedAt])
}

model GitHubPullRequest {
  id           String      @id @default(cuid())
  repositoryId String
  githubId     BigInt      @unique
  number       Int
  title        String
  body         String      @default("")
  authorLogin  String
  headRef      String
  baseRef      String
  state        PrState
  draft        Boolean     @default(false)
  reviewState  ReviewState @default(NONE)
  url          String
  openedAt     DateTime
  mergedAt     DateTime?
  closedAt     DateTime?
  githubUpdatedAt DateTime
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  repository GitHubRepository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  issueLinks GitHubIssueLink[]

  @@unique([repositoryId, number])
  @@index([state, githubUpdatedAt])
}

/// Lien ticket ↔ commit OU pull request (exactement un des deux, contrainte CHECK).
model GitHubIssueLink {
  id            String   @id @default(cuid())
  issueId       String
  commitId      String?
  pullRequestId String?
  createdAt     DateTime @default(now())

  issue       Issue              @relation(fields: [issueId], references: [id], onDelete: Cascade)
  commit      GitHubCommit?      @relation(fields: [commitId], references: [id], onDelete: Cascade)
  pullRequest GitHubPullRequest? @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@unique([issueId, commitId])
  @@unique([issueId, pullRequestId])
  @@index([pullRequestId])
  @@index([commitId])
}

/// Évènement webhook reçu — sert aussi de file de traitement (idempotence par deliveryId).
model GitHubWebhookEvent {
  id             String    @id @default(cuid())
  deliveryId     String    @unique
  event          String
  action         String?
  installationId BigInt?
  payload        Json
  status         JobStatus @default(PENDING)
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lockedAt       DateTime?
  lastError      String?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  @@index([status, nextAttemptAt])
}

model GitHubSyncState {
  id           String    @id @default(cuid())
  repositoryId String    @unique
  lastRunAt    DateTime?
  lastSuccessAt DateTime?
  lastError    String?

  repository GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

/// File de tâches de fond générique (synchronisation manuelle, relevés de sprint…).
model Job {
  id        String    @id @default(cuid())
  type      String
  payload   Json      @default("{}")
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  runAt     DateTime  @default(now())
  lockedAt  DateTime?
  lastError String?
  createdAt DateTime  @default(now())
  /// Évite d'empiler plusieurs fois la même tâche (ex. sync:repo:<id>).
  dedupeKey String?   @unique

  @@index([status, runAt])
}
